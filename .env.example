# Public WordPress URL (without trailing slash)
WORDPRESS_URL=
# Store API origin, defaults to WORDPRESS_URL
WOOCOMMERCE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Nuvex
# Número público de WhatsApp de la tienda, solo dígitos con código de país (ej. 502XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Never expose WooCommerce admin API keys via NEXT_PUBLIC_ variables
