# Public WordPress URL (without trailing slash)
WORDPRESS_URL=
# Store API origin, defaults to WORDPRESS_URL
WOOCOMMERCE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Nuvex
# Número público de WhatsApp de la tienda, solo dígitos con código de país (ej. 502XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Never expose WooCommerce admin API keys via NEXT_PUBLIC_ variables

# ---------- Panel /admin (solo servidor; NUNCA con prefijo NEXT_PUBLIC_) ----------
# API REST de WooCommerce (wc/v3) con permisos de Lectura/Escritura. Requiere WOOCOMMERCE_URL o WORDPRESS_URL con https.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# Usuario de WordPress (Shop Manager) y su contraseña de aplicación, para subir imágenes a Medios. Opcional.
WP_API_USER=
WP_APPLICATION_PASSWORD=
# Secreto para firmar la cookie de sesión, mínimo 32 caracteres: openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Correo del administrador y hash scrypt "salt:hash" (hex) de su contraseña. Nunca la contraseña en texto plano.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
